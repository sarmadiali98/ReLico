target C {
    fast: true
}

reactor Checker {
  input observeStopResultToChkFromC: int
  state violation: int = 0
  logical action observeStopResult_action: int

  reaction(startup) {=
    self->violation = 0;
  =}

  reaction(observeStopResult_action) {=
    if (self->violation == 0) { self->violation = 1; } else {}
  =}

  reaction(observeStopResultToChkFromC) {=
    if (self->violation == 0) { self->violation = 1; } else {}
  =}
}

reactor Controller {
  output observeStopResultToChk: int
  state fault: int = 0
  logical action start_action: void
  logical action turnOff_action: int

  reaction(startup) -> start_action {=
    self->fault = 0;
  =}

  reaction(start_action) -> turnOff_action {=
    self->fault = 1;
  =}

  reaction(turnOff_action) -> observeStopResultToChk {=
    if (self->fault == 1) { self->fault = 0; } else {}
  =}
}

reactor KeepAlive {
  state phase: int = 0
  logical action tick_action1: void
  logical action tick_action2: void

  reaction(startup) -> tick_action1 {=
    self->phase = 0;
  =}

  reaction(tick_action1) -> tick_action2 {=
    if ((self->phase == 0)) { self->phase = 1; } else { self->phase = 0; }
  =}

  reaction(tick_action2) -> tick_action2 {=
    if ((self->phase == 0)) { self->phase = 1; } else { self->phase = 0; }
  =}
}

@property(name="Alarm_NoStopFailure", tactic="bmc", spec="G[0, 1500 msec]((Alarm_chk_violation == 0))", CT=20, expect=false)

main reactor Alarm {
  c = new Controller()
  chk = new Checker()
  ka = new KeepAlive()
  c.observeStopResultToChk -> chk.observeStopResultToChkFromC after 0 msec
}
